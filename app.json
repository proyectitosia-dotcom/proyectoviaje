{
  "expo": {
    "name": "Proyecto Viaje",
    "slug": "proyectoviaje",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.proyectoviaje.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ],
        "NSLocationWhenInUseUsageDescription": "Proyecto Viaje usa tu ubicación para mostrarte en el mapa y ayudarte a llegar a tus destinos."
      }
    },
    "android": {
      "package": "com.proyectoviaje.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Proyecto Viaje usa tu ubicación para mostrarte en el mapa y ayudarte a llegar a tus destinos."
        }
      ]
    ]
  }
}